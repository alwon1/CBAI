@page "/membership/review"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Staff,BoardMember")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using CBAI.Web.Data
@using CBAI.Web.Membership
@inject IMembershipApplicationService Applications
@inject UserManager<ApplicationUser> Users
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Review applications</PageTitle>
<div class="page-heading"><p class="eyebrow">Committee</p><h1>Membership applications</h1><p>Review submitted and waitlisted applications. Every action is recorded in the audit log.</p></div>
@if (items is null) { <p>Loading applications…</p> } else if(items.Count==0){<div class="empty-state"><h2>No applications to review</h2></div>} else {<div class="review-list">@foreach(var item in items){<article class="review-card"><div><span class="status-pill @item.Status.ToString().ToLowerInvariant()">@item.Status</span><h2>@Name(item.ApplicantUserId)</h2><p>@item.RequestedMembershipTypeName membership · submitted @(item.SubmittedAtUtc?.ToString("d MMM yyyy") ?? "—")</p></div><InputTextArea class="form-control notes" @bind-Value="notes[item.Id]" placeholder="Committee notes (optional)"/><div class="button-row">@if(item.Status==MembershipApplicationStatus.Rejected){<button class="secondary-action" @onclick="()=>Move(item.Id,MembershipApplicationStatus.Submitted)">Return to review</button>}else{<button class="primary-action" @onclick="()=>Move(item.Id,MembershipApplicationStatus.Approved)">Approve</button><button class="secondary-action" @onclick="()=>Move(item.Id,MembershipApplicationStatus.Waitlisted)">Waitlist</button><button class="danger-action" @onclick="()=>Move(item.Id,MembershipApplicationStatus.Rejected)">Reject</button>@if(item.Status==MembershipApplicationStatus.Waitlisted){<button class="secondary-action" @onclick="()=>Move(item.Id,MembershipApplicationStatus.Submitted)">Remove from waitlist</button>}}</div><details><summary>Audit log</summary>@foreach(var audit in Audits(item.Id)){<p class="audit-row"><strong>@audit.Action</strong> · @audit.TimestampUtc.ToString("g") @if(!string.IsNullOrWhiteSpace(audit.Details)){<span>— @audit.Details</span>}</p>}</details></article>}</div>}
@code {
 private IReadOnlyList<MembershipApplication>? items; private string? userId; private readonly Dictionary<string,string> names=[]; private readonly Dictionary<Guid,string> notes=[]; private readonly Dictionary<Guid,IReadOnlyList<MembershipApplicationAuditEntry>> audits=[];
 protected override async Task OnInitializedAsync(){userId=Users.GetUserId((await AuthenticationState.GetAuthenticationStateAsync()).User);await Load();}
 private async Task Load(){items=await Applications.GetReviewQueueAsync();names.Clear();audits.Clear();var userTasks=items.Select(x=>Users.FindByIdAsync(x.ApplicantUserId));var auditTasks=items.Select(x=>Applications.GetAuditTrailAsync(x.Id));var userResults=await Task.WhenAll(userTasks);var auditResults=await Task.WhenAll(auditTasks);for(var i=0;i<items.Count;i++){var x=items[i];names[x.ApplicantUserId]=userResults[i]?.Email??"Applicant";notes.TryAdd(x.Id,"");audits[x.Id]=auditResults[i];}}
 private string Name(string id)=>names.GetValueOrDefault(id,"Applicant"); private IReadOnlyList<MembershipApplicationAuditEntry> Audits(Guid id)=>audits.GetValueOrDefault(id,[]);
 private async Task Move(Guid id,MembershipApplicationStatus status){if(userId is null)return;await Applications.ChangeStatusAsync(id,userId,status,notes.GetValueOrDefault(id));await Load();}
}
