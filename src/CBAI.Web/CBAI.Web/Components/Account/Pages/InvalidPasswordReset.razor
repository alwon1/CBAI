@page "/Account/InvalidPasswordReset"
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>Invalid password reset</PageTitle>

<div style="max-width: 36rem; margin: 4rem auto; padding: 0 1rem;">
    <section style="padding: 2rem; border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 1rem; background: var(--neutral-layer-1, #fff);">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <h1 style="margin: 0;">Invalid password reset</h1>
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                The password reset link is invalid.
            </FluentMessageBar>
        </div>
    </section>
</div>
