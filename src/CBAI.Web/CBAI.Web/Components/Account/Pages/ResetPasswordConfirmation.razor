@page "/Account/ResetPasswordConfirmation"
@using Microsoft.FluentUI.AspNetCore.Components
<PageTitle>Reset password confirmation</PageTitle>

<div style="max-width: 36rem; margin: 4rem auto; padding: 0 1rem;">
    <section style="padding: 2rem; border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 1rem; background: var(--neutral-layer-1, #fff);">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <h1 style="margin: 0;">Reset password confirmation</h1>
            <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">
                Your password has been reset. Please <a href="Account/Login">click here to log in</a>.
            </FluentMessageBar>
        </div>
    </section>
</div>
