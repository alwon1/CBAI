@page "/Account/ForgotPasswordConfirmation"
@using Microsoft.FluentUI.AspNetCore.Components

<PageTitle>Forgot password confirmation</PageTitle>

<div style="max-width: 36rem; margin: 4rem auto; padding: 0 1rem;">
    <section style="padding: 2rem; border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 1rem; background: var(--neutral-layer-1, #fff);">
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            <h1 style="margin: 0;">Forgot password confirmation</h1>
            <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">
                Please check your email to reset your password.
            </FluentMessageBar>
        </div>
    </section>
</div>
