@using Microsoft.FluentUI.AspNetCore.Components

@if (!string.IsNullOrEmpty(DisplayMessage))
{
    <FluentMessageBar Intent="@GetIntent(DisplayMessage)" AllowDismiss="false">
        @DisplayMessage
    </FluentMessageBar>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    private static MessageIntent GetIntent(string displayMessage)
        => displayMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase)
            ? MessageIntent.Error
            : MessageIntent.Success;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
