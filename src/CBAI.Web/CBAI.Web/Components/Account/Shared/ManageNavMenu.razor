@using Microsoft.AspNetCore.Identity
@using CBAI.Web.Data
@using Microsoft.FluentUI.AspNetCore.Components

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<FluentCard>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
        <FluentAnchor Href="@ProfileHref" Appearance="@GetAppearance(ProfileHref)">Profile</FluentAnchor>
        <FluentAnchor Href="@EmailHref" Appearance="@GetAppearance(EmailHref)">Email</FluentAnchor>
        <FluentAnchor Href="@PasswordHref" Appearance="@GetAppearance(PasswordHref)">Password</FluentAnchor>
        @if (hasExternalLogins)
        {
            <FluentAnchor Href="@ExternalLoginsHref" Appearance="@GetAppearance(ExternalLoginsHref)">External logins</FluentAnchor>
        }
        <FluentAnchor Href="@TwoFactorHref" Appearance="@GetAppearance(TwoFactorHref)">Two-factor authentication</FluentAnchor>
        <FluentAnchor Href="@PasskeysHref" Appearance="@GetAppearance(PasskeysHref)">Passkeys</FluentAnchor>
        <FluentAnchor Href="@PersonalDataHref" Appearance="@GetAppearance(PersonalDataHref)">Personal data</FluentAnchor>
    </FluentStack>
</FluentCard>

@code {
    private const string ProfileHref = "Account/Manage";
    private const string EmailHref = "Account/Manage/Email";
    private const string PasswordHref = "Account/Manage/ChangePassword";
    private const string ExternalLoginsHref = "Account/Manage/ExternalLogins";
    private const string TwoFactorHref = "Account/Manage/TwoFactorAuthentication";
    private const string PasskeysHref = "Account/Manage/Passkeys";
    private const string PersonalDataHref = "Account/Manage/PersonalData";

    private bool hasExternalLogins;
    private string currentPath = "/";

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
        currentPath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
    }

    private Appearance GetAppearance(string href)
    {
        var targetPath = "/" + href.TrimStart('/').TrimEnd('/');
        if (targetPath == "/")
        {
            targetPath = "/";
        }

        return string.Equals(currentPath.TrimEnd('/'), targetPath.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
            ? Appearance.Accent
            : Appearance.Stealth;
    }
}
