@using Microsoft.FluentUI.AspNetCore.Components

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <StatusMessage Message="@StatusMessage" />
    }

    <h3>Recovery codes</h3>

    <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
        <strong>Put these codes in a safe place.</strong>
        <div>If you lose your device and don't have the recovery codes you will lose access to your account.</div>
    </FluentMessageBar>

    <FluentCard>
        <div>
            @foreach (var recoveryCode in RecoveryCodes)
            {
                <code class="recovery-code">@recoveryCode</code>
            }
        </div>
    </FluentCard>
</FluentStack>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
