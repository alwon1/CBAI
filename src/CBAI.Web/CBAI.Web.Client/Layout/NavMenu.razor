@implements IDisposable

@using CBAI.Web.Client.Security
@inject NavigationManager NavigationManager

<div class="nav-menu">
    <FluentNavMenu Title="CBAI" Width="280" Collapsible="true">
        <FluentNavLink Href="" Match="NavLinkMatch.All">Home</FluentNavLink>
        <FluentNavLink Href="auth">Auth Required</FluentNavLink>

        <AuthorizeView Roles="@Roles.Administrator">
            <FluentNavLink Href="admin/users">Manage Users</FluentNavLink>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <FluentNavLink Href="Account/Manage">@context.User.Identity?.Name</FluentNavLink>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <FluentButton Id="components-logout-button" Type="ButtonType.Submit" Appearance="Appearance.Stealth">
                        Logout
                    </FluentButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <FluentNavLink Href="Account/Register">Register</FluentNavLink>
                <FluentNavLink Href="Account/Login">Login</FluentNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </FluentNavMenu>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
